{
  "name": "zerodot",
  "private": true,
  "version": "0.2.10",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "rotate-key": "pnpm --filter @zerodot/db rotate-key",
    "stats:rebuild": "pnpm --filter @zerodot/db stats:rebuild"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
