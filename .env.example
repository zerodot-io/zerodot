DATABASE_URL=postgres://zerodot:zerodot@localhost:5432/zerodot
VALKEY_URL=redis://localhost:6379
# 32 random bytes in base64. Make one with: openssl rand -base64 32
# This key encrypts credentials. If you lose it, saved credentials cannot be opened.
ZERODOT_SECRET_KEY=
BETTER_AUTH_SECRET=
ZERODOT_BASE_URL=http://localhost:3000
ZERODOT_SIGNUP_DISABLED=false
# System page for the instance admin. Set to false to turn it off (all admin calls answer 404).
ZERODOT_ADMIN_UI=true
# Emails of instance admins, comma separated. When empty, the first user who signed up is the admin.
ZERODOT_ADMIN_EMAILS=
# Most rows one data table can hold.
ZERODOT_TABLE_MAX_ROWS=100000
# Insight rollups older than this many days are deleted each day.
ZERODOT_STATS_RETENTION_DAYS=365
# Test runs older than this many days are deleted each day.
ZERODOT_TEST_RUN_RETENTION_DAYS=7
# Finished production runs older than this many days are deleted each day. A project can set its own days.
ZERODOT_RUN_RETENTION_DAYS=30
# Most requests one API process holds open for a run (wait=true, webhook response modes). Over it: 503.
ZERODOT_MAX_HELD_WEBHOOKS=500
# A webhook lookup stays in the process this many ms. A deactivated webhook can still answer this long. 0 turns it off.
ZERODOT_WEBHOOK_CACHE_MS=5000
# Address the API, worker and sandbox listen on. Default 0.0.0.0 (Docker). Without Docker use 127.0.0.1.
# ZERODOT_BIND_HOST=127.0.0.1
# Dev only. The worker reaches the sandbox here. Docker compose sets its own value.
SANDBOX_URL=http://localhost:3002
# More origins that may sign in, comma separated. ZERODOT_BASE_URL is always allowed. Example: https://dev.softinttech.org,http://localhost:3000
ZERODOT_TRUSTED_ORIGINS=
# Set to true only behind a proxy that sets X-Forwarded-For. The "IP(s) Allowlist" option of the Webhook node needs it.
ZERODOT_TRUST_PROXY=false
# The most node runs in one workflow run. A loop that does not end stops here.
ZERODOT_MAX_NODE_RUNS=1000
# Comma-separated node packages to install and load at start, for example @zerodot/redis,@zerodot/postgres.
ZERODOT_NODE_PACKAGES=
# Folder for node packages that an admin installs in the app. Keep it on a volume.
# ZERODOT_NODES_DIR=./.zerodot/nodes
# Set to false to turn off installing and removing packages in the app.
# ZERODOT_NODES_INSTALL=true
# Docker Compose only: the passwords of the database and of Valkey. scripts/install.sh sets random
# ones. Empty: the database password is "zerodot" and Valkey has no password (local development).
ZERODOT_DB_PASSWORD=
ZERODOT_VALKEY_PASSWORD=
# Community registries and packages. Off by default. A community package runs in its own process
# with no secrets, but it gets the credentials and data of its nodes and can use the network.
# Turn on only when you trust the authors of the packages you install.
# ZERODOT_COMMUNITY_NODES=true
# Hosts inside your network that community packages may reach (names or IPs, comma-separated).
# By default they reach only the internet.
# ZERODOT_COMMUNITY_NODES_ALLOW_HOSTS=
# Set to false to install only community packages that the zerodot team reviewed.
# ZERODOT_UNVERIFIED_NODES=true
# Execute Command runs shell commands on the worker. Off unless this is true. Anyone who can edit a workflow can use it.
ZERODOT_ENABLE_EXECUTE_COMMAND=false
# Read/Write Files from Disk can only reach files inside this folder on the worker. Empty: the node is off.
ZERODOT_FILES_DIR=
# Sandbox: one URL, or several separated by commas. The worker spreads code runs over them.
# SANDBOX_URL=http://sandbox-1:3002,http://sandbox-2:3002
# Docker compose: number of sandbox containers.
# SANDBOX_REPLICAS=1
# Sandbox: how long a code run waits for a free slot, in ms, before the sandbox answers "busy".
SANDBOX_MAX_WAIT_MS=250
# Sandbox: most code runs that wait for a slot. Default: SANDBOX_MAX_CONCURRENCY.
# SANDBOX_MAX_QUEUE=4
# Worker: jobs of the system queue (cron, poll, retention, sweep) that run at once.
ZERODOT_SYSTEM_CONCURRENCY=5
# Fair share. Most runs of one project / one workflow that run at once. 0 = no cap.
ZERODOT_ORG_MAX_CONCURRENT_RUNS=0
ZERODOT_WORKFLOW_MAX_CONCURRENT_RUNS=0
# Most listen triggers (for example IMAP) one worker keeps open.
ZERODOT_MAX_LISTEN_TRIGGERS=100
# Valkey high availability. Leave empty for a plain VALKEY_URL.
# Sentinel: VALKEY_SENTINELS=host:port,host:port (VALKEY_URL is ignored)
VALKEY_SENTINELS=
VALKEY_SENTINEL_NAME=mymaster
# Cluster: true. VALKEY_URL is the first node.
VALKEY_CLUSTER=false
# Password of the Valkey data nodes in Sentinel and Cluster mode.
VALKEY_PASSWORD=

# Large and binary node data. Off when neither ZERODOT_BLOB_DIR nor ZERODOT_BLOB_S3_BUCKET is set.
# Web, API and worker must use the same store. A disk directory must be a shared volume.
ZERODOT_BLOB_DIR=
# S3 or an S3-compatible service (wins over ZERODOT_BLOB_DIR). Needs the two keys.
ZERODOT_BLOB_S3_BUCKET=
ZERODOT_BLOB_S3_ENDPOINT=
ZERODOT_BLOB_S3_REGION=
ZERODOT_BLOB_S3_ACCESS_KEY_ID=
ZERODOT_BLOB_S3_SECRET_ACCESS_KEY=
ZERODOT_BLOB_S3_PREFIX=
ZERODOT_BLOB_S3_FORCE_PATH_STYLE=
# A node input or output above this size (bytes) is stored as a blob. Files always are.
ZERODOT_INLINE_OUTPUT_BYTES=262144
# false: production runs do not keep input and output of nodes that succeeded.
ZERODOT_SAVE_SUCCESS_NODE_DATA=true
