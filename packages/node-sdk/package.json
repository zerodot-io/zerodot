{
  "name": "@zerodot/node-sdk",
  "version": "1.2.1",
  "description": "Contract for zerodot node packages: node types, helpers and the SDK version.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/zerodot.git",
    "directory": "packages/node-sdk"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@zerodot/config": "workspace:*",
    "tsdown": "^0.23.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@zerodot/engine": "workspace:*",
    "zod": "4.6.7"
  }
}
